# nævis: configuration names only; no values or credentials.
# This application does not load .env files automatically.
# Default startup requires no environment file.
# Keep these entries commented and empty. Operator setup is separate.

# Optional local HTTP port (default is defined in src/server.mjs):
# ON_PORT=

# Operator-controlled engine adapter and public package scan settings:
# ON_ENGINE_ADAPTER=
# ON_PROJECT_DIRECTORY=
# ON_APPROVED_PUBLIC_PACKAGES=

# Do not put authentication material or private settings in this example.
# Native and SDP configuration files are provided outside the repository.
